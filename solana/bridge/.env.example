# Solana RPC endpoint (localnet, devnet, or mainnet-beta)
SOLANA_RPC_URL=http://127.0.0.1:8899

# Match server base URL
MATCH_SERVER_URL=https://telegraph-duel-match-server.marvelus.workers.dev

# Agent ID to Solana wallet mapping (comma-separated)
# Format: agentId:walletPrivateKeyBase58,agentId:walletPrivateKeyBase58
# Example: alice:5J7X...,bob:3K9Y...
AGENT_WALLET_MAP=

# Fee payer wallet private key (base58)
# Used to pay transaction fees for settlement
FEE_PAYER_PRIVATE_KEY=

# Program ID (should match your deployed program)
PROGRAM_ID=HLnw6FpGrfM7RD37gEMisMMA473GRtQ6zECMkdPqcbmM

# Polling interval in milliseconds (default: 5000)
POLL_INTERVAL_MS=5000

# Enable publishing settlement events to match-server (default: false)
# When enabled, bridge POSTs score.settled events to Worker for WS broadcast to spectators
PUBLISH_SETTLEMENT_EVENTS=true
